# Groq API Key
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional model override (defaults to openai/gpt-oss-20b or groq/compound-mini)
GROQ_MODEL=openai/gpt-oss-20b

# Neon PostgreSQL Connection String
# Example: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL=postgresql://neondb_owner:your_password_here@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
